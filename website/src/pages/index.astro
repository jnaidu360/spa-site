---
import Layout from '../layouts/Layout.astro';
import { messages, SITE_LANG_STORAGE_KEY } from '../i18n/site';

const phoneDisplay = '1 (619) 349-9996';
const phoneHref = 'tel:+16193499996';
const address = '9540 Waples St Suite D, San Diego, CA 92121';
const heroVideo =
	'https://video.wixstatic.com/video/322fab_980552a6502e453d958f8083a307e481/1080p/mp4/file.mp4';
const treatmentVideo =
	'https://video.wixstatic.com/video/11062b_3d68351cded1425a83c0d418196c02ba/1080p/mp4/file.mp4';
const calmVideo =
	'https://video.wixstatic.com/video/11062b_cf4444776baf4b40a69972b4abe23417/720p/mp4/file.mp4';
const brandImage =
	'https://static.wixstatic.com/media/322fab_ee77a6b814ee4d71a73bbb0831313f8e~mv2.png';

const t = (key: string) => messages.en[key] ?? '';

const navItems = [
	{ key: 'nav.about', href: '#about' },
	{ key: 'nav.treatments', href: '#treatments' },
	{ key: 'nav.hours', href: '#hours' },
	{ key: 'nav.contact', href: '#contact' },
];

const treatments = [
	{
		titleKey: 'treatment.deep.title',
		textKey: 'treatment.deep.text',
		price: '$80 per hour / $60 per half hour',
	},
	{
		titleKey: 'treatment.pain.title',
		textKey: 'treatment.pain.text',
		priceKey: 'treatment.pain.price',
	},
	{
		titleKey: 'treatment.hot.title',
		textKey: 'treatment.hot.text',
		priceKey: 'treatment.hot.price',
	},
	{
		titleKey: 'treatment.cup.title',
		textKey: 'treatment.cup.text',
		price: '$40 per half hour',
	},
];

const experienceCards = [
	{
		titleKey: 'exp.skilled.title',
		textKey: 'exp.skilled.text',
	},
	{
		titleKey: 'exp.personal.title',
		textKey: 'exp.personal.text',
	},
	{
		titleKey: 'exp.rest.title',
		textKey: 'exp.rest.text',
	},
];
---

<Layout title={t('meta.title')} description={t('meta.description')}>
	<header class="site-header">
		<a class="brand" id="site-brand" href="#top" data-i18n-aria="brand.aria" aria-label={t('brand.aria')}>
			<span class="brand-logo-bg">
				<img
					class="brand-logo"
					src="/waples-spa-navbar-logo.png"
					width="320"
					height="140"
					alt=""
				/>
			</span>
			<span class="brand-wordmark">
				<span>Waples</span>
				<small>SPA</small>
			</span>
		</a>
		<nav class="main-nav" aria-label="Primary navigation">
			{navItems.map((item) => (
				<a href={item.href} data-i18n={item.key}>
					{t(item.key)}
				</a>
			))}
		</nav>
		<div class="header-end">
			<div class="lang-switch" role="group" data-i18n-aria="aria.lang" aria-label={t('aria.lang')}>
				<button type="button" class="lang-switch-btn" data-set-lang="en" aria-pressed="true">
					{t('lang.switchEn')}
				</button>
				<span class="lang-switch-sep" aria-hidden="true">|</span>
				<button type="button" class="lang-switch-btn" data-set-lang="zh" aria-pressed="false">
					{t('lang.switchZh')}
				</button>
			</div>
			<a class="header-cta" href={phoneHref} data-i18n="cta.book">
				{t('cta.book')}
			</a>
		</div>
	</header>

	<main id="top">
		<section class="hero" aria-label={t('aria.hero')} data-i18n-aria="aria.hero">
			<video class="hero-media" autoplay muted loop playsinline src={heroVideo}></video>
			<div class="hero-overlay"></div>
			<div class="hero-content">
				<p class="eyebrow" data-i18n="hero.eyebrow">{t('hero.eyebrow')}</p>
				<h1>
					Waples <span class="smaller">SPA</span>
				</h1>
				<p data-i18n="hero.lead">{t('hero.lead')}</p>
				<div class="button-row">
					<a class="button primary" href={phoneHref} data-i18n="hero.reserve">
						{t('hero.reserve')}
					</a>
					<a class="button ghost" href="#treatments" data-i18n="hero.viewTreatments">
						{t('hero.viewTreatments')}
					</a>
				</div>
			</div>
		</section>

		<section class="intro" id="about">
			<div class="intro-copy">
				<p class="eyebrow" data-i18n="intro.eyebrow">{t('intro.eyebrow')}</p>
				<h2 data-i18n="intro.h2">{t('intro.h2')}</h2>
			</div>
			<div class="intro-details">
				<p data-i18n="intro.p1">{t('intro.p1').replace('{address}', address)}</p>
				<p data-i18n="intro.p2">{t('intro.p2')}</p>
				<a class="text-link" href={phoneHref} data-i18n="intro.call">
					{t('intro.call').replace('{phone}', phoneDisplay)}
				</a>
			</div>
		</section>

		<section class="text-image text-image-right">
			<div class="panel panel-sage">
				<p class="eyebrow" data-i18n="panel.therapeutic.eyebrow">{t('panel.therapeutic.eyebrow')}</p>
				<h2 data-i18n="panel.therapeutic.h2">{t('panel.therapeutic.h2')}</h2>
				<p data-i18n="panel.therapeutic.p">{t('panel.therapeutic.p')}</p>
				<a class="button dark" href="#treatments" data-i18n="panel.therapeutic.cta">
					{t('panel.therapeutic.cta')}
				</a>
			</div>
			<div class="media-card">
				<video autoplay muted loop playsinline src={treatmentVideo}></video>
			</div>
		</section>

		<section class="text-image text-image-left">
			<div class="media-card framed">
				<video autoplay muted loop playsinline src={calmVideo}></video>
			</div>
			<div class="panel panel-linen">
				<p class="eyebrow" data-i18n="panel.personal.eyebrow">{t('panel.personal.eyebrow')}</p>
				<h2 data-i18n="panel.personal.h2">{t('panel.personal.h2')}</h2>
				<p data-i18n="panel.personal.p">{t('panel.personal.p')}</p>
				<a class="button outline" href={phoneHref} data-i18n="panel.personal.cta">
					{t('panel.personal.cta')}
				</a>
			</div>
		</section>

		<section class="featured" id="treatments">
			<div class="featured-header">
				<p class="eyebrow" data-i18n="featured.eyebrow">{t('featured.eyebrow')}</p>
				<h2 data-i18n="featured.h2">{t('featured.h2')}</h2>
				<p data-i18n="featured.lead">{t('featured.lead')}</p>
			</div>
			<div class="treatment-grid">
				{
					treatments.map((treatment) => (
						<article class="treatment-card">
							<div>
								<p class="card-kicker">
									{treatment.priceKey ? (
										<span data-i18n={treatment.priceKey}>{t(treatment.priceKey)}</span>
									) : (
										treatment.price
									)}
								</p>
								<h3 data-i18n={treatment.titleKey}>{t(treatment.titleKey)}</h3>
								<p data-i18n={treatment.textKey}>{t(treatment.textKey)}</p>
							</div>
							<a href={phoneHref} data-i18n="treatment.book">
								{t('treatment.book')}
							</a>
						</article>
					))
				}
			</div>
		</section>

		<section class="experience">
			<div class="experience-image" style={`background-image: url(${brandImage});`}></div>
			<div class="experience-content">
				<p class="eyebrow" data-i18n="experience.eyebrow">{t('experience.eyebrow')}</p>
				<h2 data-i18n="experience.h2">{t('experience.h2')}</h2>
				<div class="experience-list">
					{
						experienceCards.map((card) => (
							<article>
								<h3 data-i18n={card.titleKey}>{t(card.titleKey)}</h3>
								<p data-i18n={card.textKey}>{t(card.textKey)}</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section class="amenities" id="hours">
			<div class="amenities-header">
				<p class="eyebrow" data-i18n="amenities.eyebrow">{t('amenities.eyebrow')}</p>
				<h2 data-i18n="amenities.h2">{t('amenities.h2')}</h2>
			</div>
			<div class="amenities-grid">
				<div>
					<h3 data-i18n="amen.hoursTitle">{t('amen.hoursTitle')}</h3>
					<p data-i18n="amen.hoursBody">{t('amen.hoursBody')}</p>
				</div>
				<div>
					<h3 data-i18n="amen.resTitle">{t('amen.resTitle')}</h3>
					<p><a href={phoneHref}>{phoneDisplay}</a></p>
				</div>
				<div>
					<h3 data-i18n="amen.addrTitle">{t('amen.addrTitle')}</h3>
					<p>{address}</p>
				</div>
			</div>
		</section>
	</main>

	<footer class="site-footer" id="contact">
		<div>
			<p class="footer-brand">Waples SPA</p>
			<p data-i18n="footer.tagline">{t('footer.tagline')}</p>
		</div>
		<div>
			<a href={phoneHref}>{phoneDisplay}</a>
			<span>{address}</span>
		</div>
	</footer>

	<script
		is:inline
		define:vars={{ messages, SITE_LANG_STORAGE_KEY, address, phoneDisplay }}
	>
		(function () {
			function fill(s) {
				return String(s).replaceAll('{address}', address).replaceAll('{phone}', phoneDisplay);
			}

			function applyLang(lang) {
				const pack = messages[lang];
				if (!pack) return;

				document.documentElement.lang = lang === 'zh' ? 'zh' : 'en';
				try {
					localStorage.setItem(SITE_LANG_STORAGE_KEY, lang);
				} catch {}

				document.querySelectorAll('[data-i18n]').forEach(function (el) {
					var key = el.getAttribute('data-i18n');
					if (!key || pack[key] == null) return;
					el.textContent = fill(pack[key]);
				});

				document.querySelectorAll('[data-i18n-aria]').forEach(function (el) {
					var key = el.getAttribute('data-i18n-aria');
					if (!key || pack[key] == null) return;
					el.setAttribute('aria-label', fill(pack[key]));
				});

				var meta = document.querySelector('meta[name="description"]');
				if (meta && pack['meta.description'] != null) {
					meta.setAttribute('content', fill(pack['meta.description']));
				}
				if (pack['meta.title'] != null) {
					document.title = fill(pack['meta.title']);
				}

				document.querySelectorAll('[data-set-lang]').forEach(function (btn) {
					var active = btn.getAttribute('data-set-lang') === lang;
					btn.setAttribute('aria-pressed', active ? 'true' : 'false');
				});
			}

			function detectInitial() {
				try {
					var stored = localStorage.getItem(SITE_LANG_STORAGE_KEY);
					if (stored === 'en' || stored === 'zh') return stored;
				} catch {}
				if (
					typeof navigator !== 'undefined' &&
					navigator.language &&
					navigator.language.toLowerCase().indexOf('zh') === 0
				) {
					return 'zh';
				}
				return 'en';
			}

			applyLang(detectInitial());

			document.querySelectorAll('[data-set-lang]').forEach(function (btn) {
				btn.addEventListener('click', function () {
					var lang = btn.getAttribute('data-set-lang');
					if (lang === 'en' || lang === 'zh') applyLang(lang);
				});
			});
		})();
	</script>
</Layout>

<style>
	.site-header {
		--header-pad-x: clamp(1rem, 4vw, 4rem);
		--header-pad-y: 1.25rem;
		position: fixed;
		z-index: 20;
		top: 0;
		left: 0;
		right: 0;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: stretch;
		gap: 2rem;
		padding: var(--header-pad-y) var(--header-pad-x);
		background: rgba(255, 250, 244, 0.9);
		backdrop-filter: blur(16px);
		border-bottom: 1px solid rgba(47, 46, 51, 0.12);
	}

	.brand {
		align-self: stretch;
		display: flex;
		align-items: center;
		height: 100%;
		gap: 0.65rem;
		min-height: 0;
		text-decoration: none;
		color: var(--color-ink);
	}

	.brand-logo-bg {
		align-self: stretch;
		display: flex;
		align-items: center;
		box-sizing: border-box;
		/* +2px covers subpixel rounding so the navy meets the header bottom cleanly */
		height: calc(100% + 2 * var(--header-pad-y) + 2px);
		margin-top: calc(-1 * var(--header-pad-y));
		margin-bottom: calc(-1 * var(--header-pad-y));
		margin-left: calc(-1 * var(--header-pad-x));
		padding: var(--header-pad-y) calc(0.55rem + 14px) var(--header-pad-y) var(--header-pad-x);
		background: #0a212b;
	}

	.brand-logo {
		display: block;
		height: clamp(2rem, 3.6vw, 2.85rem);
		width: auto;
		max-width: min(260px, 52vw);
		object-fit: contain;
	}

	.brand-wordmark {
		display: inline-flex;
		align-items: baseline;
		gap: 0.4rem;
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 2vw, 2.2rem);
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.brand-wordmark small {
		font-family: var(--font-body);
		font-size: 0.8rem;
		letter-spacing: 0.32em;
	}

	.main-nav {
		align-self: center;
		display: flex;
		align-items: center;
		gap: clamp(1rem, 3vw, 2.4rem);
		font-size: 0.8rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.main-nav a,
	.header-cta,
	.text-link,
	.treatment-card a,
	.site-footer a {
		text-decoration: none;
	}

	.header-cta {
		align-self: center;
		padding: 0.8rem 1.4rem;
		border: 1px solid currentColor;
		border-radius: 999px;
		font-size: 0.78rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.header-end {
		align-self: center;
		justify-self: end;
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.lang-switch {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.lang-switch-sep {
		color: rgba(47, 46, 51, 0.35);
		user-select: none;
	}

	.lang-switch-btn {
		margin: 0;
		padding: 0.35rem 0.45rem;
		border: none;
		border-radius: 4px;
		background: transparent;
		color: inherit;
		font: inherit;
		letter-spacing: inherit;
		text-transform: inherit;
		cursor: pointer;
	}

	.lang-switch-btn:hover {
		color: var(--color-olive);
	}

	.lang-switch-btn[aria-pressed='true'] {
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.hero {
		position: relative;
		min-height: 100vh;
		display: grid;
		place-items: end start;
		overflow: hidden;
		padding: 7.5rem clamp(1.25rem, 6vw, 6rem) 4.25rem;
		color: #fffaf4;
	}

	.hero-media,
	.hero-overlay {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero-media {
		object-fit: cover;
	}

	.hero-overlay {
		background:
			linear-gradient(90deg, rgba(22, 26, 21, 0.72), rgba(22, 26, 21, 0.22)),
			linear-gradient(0deg, rgba(22, 26, 21, 0.5), transparent 50%);
	}

	.hero-content {
		position: relative;
		max-width: 720px;
	}

	.eyebrow {
		margin: 0 0 1rem;
		font-size: 0.75rem;
		letter-spacing: 0.22em;
		line-height: 1.6;
		text-transform: uppercase;
		color: var(--color-olive);
	}

	.hero .eyebrow {
		color: var(--color-linen);
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1,
	h2 {
		font-family: var(--font-display);
		font-weight: 400;
		line-height: 0.95;
		letter-spacing: -0.04em;
	}

	h1 {
		margin-bottom: 1.5rem;
		font-size: clamp(4.5rem, 13vw, 11.25rem);
	}
	.smaller {
    	font-size: 0.9em;
	}

	h2 {
		margin-bottom: 1.4rem;
		font-size: clamp(2.45rem, 6.25vw, 6rem);
	}

	h3 {
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 2vw, 2.25rem);
		font-weight: 400;
	}

	p {
		color: var(--color-muted);
		font-size: clamp(1rem, 1.25vw, 1.15rem);
		line-height: 1.75;
	}

	.hero p {
		max-width: 560px;
		color: rgba(255, 250, 244, 0.86);
	}

	.button-row {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 3rem;
		padding: 0.8rem 1.5rem;
		border-radius: 999px;
		border: 1px solid currentColor;
		text-decoration: none;
		font-size: 0.82rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.button.primary,
	.button.dark {
		background: var(--color-ink);
		border-color: var(--color-ink);
		color: var(--color-white);
	}

	.button.ghost {
		color: var(--color-white);
	}

	.button.outline {
		color: var(--color-ink);
	}

	.intro,
	.featured,
	.amenities {
		padding: clamp(4.25rem, 9vw, 7.5rem) clamp(1.25rem, 6vw, 6rem);
	}

	.intro {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
		gap: clamp(2rem, 6vw, 7rem);
		align-items: start;
		background: var(--color-white);
	}

	.intro-details {
		padding-top: 1rem;
	}

	.text-link {
		display: inline-block;
		margin-top: 1rem;
		border-bottom: 1px solid currentColor;
		font-size: 0.86rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.text-image {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-items: stretch;
		min-height: 720px;
	}

	.panel {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: clamp(3rem, 7vw, 7rem);
	}

	.panel-sage {
		background: linear-gradient(var(--color-sage), rgba(255, 250, 244, 0.2));
	}

	.panel-linen {
		background: linear-gradient(var(--color-linen), rgba(255, 250, 244, 0.2));
	}

	.panel p {
		max-width: 570px;
	}

	.media-card {
		position: relative;
		min-height: 500px;
		overflow: hidden;
		background: var(--color-linen);
	}

	.media-card video {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.media-card.framed {
		margin: clamp(2rem, 5vw, 5rem);
		border: 1rem solid var(--color-white);
		box-shadow: 0 2rem 4rem rgba(47, 46, 51, 0.12);
	}

	.featured {
		background: var(--color-white);
	}

	.featured-header {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(260px, 0.7fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: end;
		margin-bottom: 3rem;
	}

	.featured-header .eyebrow {
		grid-column: 1 / -1;
		margin-bottom: 0;
	}

	.treatment-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1px;
		background: rgba(47, 46, 51, 0.16);
		border: 1px solid rgba(47, 46, 51, 0.16);
	}

	.treatment-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: 430px;
		padding: clamp(1.5rem, 3vw, 2.5rem);
		background: var(--color-cream);
	}

	.card-kicker {
		margin-bottom: 1.5rem;
		color: var(--color-olive);
		font-size: 0.78rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.treatment-card a {
		align-self: flex-start;
		margin-top: 2rem;
		border-bottom: 1px solid currentColor;
		font-size: 0.82rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.experience {
		display: grid;
		grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1.2fr);
		background: var(--color-ink);
		color: var(--color-white);
	}

	.experience-image {
		min-height: 620px;
		background-color: var(--color-linen);
		background-position: center;
		background-repeat: no-repeat;
		background-size: cover;
		filter: grayscale(0.15);
	}

	.experience-content {
		padding: clamp(4rem, 8vw, 8rem);
	}

	.experience h2,
	.experience h3 {
		color: var(--color-white);
	}

	.experience p {
		color: rgba(255, 250, 244, 0.72);
	}

	.experience-list {
		display: grid;
